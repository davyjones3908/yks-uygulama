# API Endpoints
REACT_APP_API_BASE_URL=http://localhost:3000/api
REACT_APP_API_TIMEOUT=30000

# Firebase Configuration
REACT_APP_FIREBASE_API_KEY=your_api_key_here
REACT_APP_FIREBASE_AUTH_DOMAIN=your_project.firebaseapp.com
REACT_APP_FIREBASE_PROJECT_ID=your_project_id
REACT_APP_FIREBASE_STORAGE_BUCKET=your_project.appspot.com
REACT_APP_FIREBASE_MESSAGING_SENDER_ID=your_sender_id
REACT_APP_FIREBASE_APP_ID=your_app_id

# Database
DATABASE_URL=mongodb://localhost:27017/yks-uygulama
DATABASE_USER=
DATABASE_PASSWORD=

# Server Configuration
NODE_ENV=development
PORT=3000
SECRET_KEY=your_secret_key_here

# Authentication
JWT_SECRET=your_jwt_secret_here
JWT_EXPIRY=7d

# Email Service (isteğe bağlı)
EMAIL_SERVICE=gmail
EMAIL_USER=
EMAIL_PASSWORD=

# External APIs (isteğe bağlı)
EXTERNAL_API_KEY=
EXTERNAL_API_SECRET=

# Feature Flags
ENABLE_ANALYTICS=true
ENABLE_NOTIFICATIONS=true
ENABLE_PREMIUM_FEATURES=false

# Development Tools
DEBUG=false
LOG_LEVEL=info

# ⚠️ UYARI: Gerçek şifreler veya API anahtarlarını bu dosyaya yazmeyin!
# Bu dosya GitHub'a push edilebilir. Gerçek değerler için kişisel .env dosyası kullanın.
